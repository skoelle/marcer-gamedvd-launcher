# Copy to .env and fill in the real values.
# This file is read by Compose for the ${HOST_*} interpolation and is also
# passed to the pipeline service as env_file. The gallery service does NOT
# receive this file or any of its secrets.

# --- Docker host paths -----------------------------------------------------
HOST_ROOT_DIR=/path/to/MarcersGameDVD
HOST_PATCH_DIR=/path/to/MarcersGamesDVD-Update/Patch
HOST_OUT_DIR=/path/to/MarcersGamesDVD-Update/Screenshots
# HOST_OUT_DIR must be writable for the screenshot ZIP (pipeline container rw).
HOST_DATA_DIR=/path/to/MarcersGamesDVD-Update/Data
# Create ${HOST_DATA_DIR}/state and make it writable by PUID:PGID before the first start.

PUID=1000
PGID=1000
PIPELINE_PORT=8080
GALLERY_PORT=8764
PIPELINE_IMAGE=ghcr.io/skoelle/marcer-gamedvd-launcher/pipeline:latest

# --- FTP -------------------------------------------------------------------
MARCER_FTP_HOST=host:2121
MARCER_FTP_USER=user
MARCER_FTP_PASS=password
MARCER_FTP_REMOTE=/GameDVD/
MARCER_FTP_ASSETS_REMOTE=/Uploads/MarcerGameDVDLauncher-assets/
MARCER_FTP_ENCODING=latin-1

# --- GitHub release pointer ------------------------------------------------
# Classic PAT with repo/release-asset write access.
MARCER_GITHUB_TOKEN=
MARCER_REPO=skoelle/marcer-gamedvd-launcher
MARCER_RELEASE_TAG=catalog-latest

# --- Web UI ----------------------------------------------------------------
# Optional bearer token for POST /api/run and /api/cancel.
# The UI token field is hidden while this is empty.
MARCER_PIPELINE_TOKEN=
# Scheduler (active)
MARCER_TZ=Europe/Berlin
MARCER_SCHEDULE_CRON="0 20 * * 4"
MARCER_SCHEDULE_CATCH_UP_HOURS=24

# --- E-mail notification (optional) ---------------------------------------
# Sent only after a successful full run with new/changed files.
MARCER_SMTP_HOST=
MARCER_SMTP_PORT=587
MARCER_SMTP_USER=
MARCER_SMTP_PASS=
MARCER_SMTP_STARTTLS=1
MARCER_SMTP_SSL=0
MARCER_MAIL_FROM=
MARCER_MAIL_TO=
