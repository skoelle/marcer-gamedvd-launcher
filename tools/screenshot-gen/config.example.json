{
  "scope_default": "cracked",
  "scopes": {
    "cracked": {
      "trees": [
        "Title Sorted/Cracked Games - Title Sorted"
      ]
    },
    "utils": {
      "trees": [
        "Title Sorted/Utilitys - Title Sorted"
      ]
    },
    "pd": {
      "trees": [
        "Title Sorted/PD Games - Title Sorted"
      ]
    },
    "magazine": {
      "trees": [
        "Bonus/Magazine Cover Disks"
      ],
      "exclude_dirs": [
        "dupes"
      ],
      "boot": "auto"
    },
    "falcon": {
      "trees": [
        "Falcon 030/Title Sorted"
      ],
      "index": "index-falcon.json",
      "tos_default": "4.04",
      "timepoints": [15, 30, 60],
      "profile": {
        "name": "falcon",
        "machine": "falcon",
        "memsize": "14",
        "zoom": "1",
        "monitor": "rgb",
        "extra_args": ["--dsp", "emu", "--cpuclock", "16"]
      }
    }
  },
  "mono_dir_suffix": "Mono",
  "monitor_overrides": {
    "pd:Tartan - Col and Mon": "mono",
    "pd:Ti Shoot - Col and Mon": "mono",
    "pd:Tic Tac Toe Game": "mono",
    "pd:Turme von Hanoi - Col and Mon": "mono",
    "pd:Tuerme von Hanoi - Col and Mon": "mono",
    "pd:Turme von Hanoi - Fantisoft": "mono"
  },
  "screen_format_monitor": {
    "utils": {
      "default": "mono",
      "color_hints": ["not mono", "low", "mid", "medium", "color", "colour"],
      "mono_hints": ["mono", "high"]
    },
    "pd": {
      "mono_if_all": ["high"]
    }
  },
  "exclude_dirs": ["kryoflux", "boxscan", "manual"],
  "timepoints": [10, 25, 45],
  "entry_timeout_s": 90,
  "keep_candidates": true,
  "tos_default": "1.04",
  "tos_images": {
    "1.04": "MARCER_TOS_IMG",
    "1.02": "MARCER_TOS102_IMG",
    "4.04": "MARCER_TOS404_IMG"
  },
  "disk_skip_regex": "(?i)(?:^|[\\s\\-_.])(?:disk|side|disc)[\\s\\-_.]*(?:[2-9]|b|ii|iii)(?:$|[\\s\\-_.])",
  "filters": {
    "black_mean_max": 0.02,
    "black_std_max": 1.0,
    "black_std_content_min": 6.0,
    "desktop_max_colors": 5,
    "desktop_min_mean": 0.5,
    "desktop_green_frac_min": 0.02,
    "textscreen_min_white": 0.5,
    "white_pixel_min": 230,
    "phash_max_distance": 6,
    "falcon_boot_logo_phash": "870703f8f8f8f807",
    "falcon_boot_logo_max_distance": 2,
    "falcon_boot_logo_green_min": 0.20,
    "falcon_boot_logo_stage_white_min": 0.20,
    "falcon_boot_logo_white_min": 0.98,
    "falcon_boot_logo_max_colors": 2,
    "falcon_boot_logo_max_x": 0.30,
    "falcon_boot_logo_max_y": 0.45
  },
  "score_weights": {
    "entropy": 0.4,
    "colors": 0.3,
    "edges": 0.3
  },
  "click_retry": {
    "probe_time": 10,
    "timepoints_after_click": [10, 25, 45],
    "entry_timeout_s": 120,
    "icon_min_score": 0.5,
    "window_icon_min_score": 0.80,
    "step_wait": 5.0,
    "drive_max_depth": 2,
    "drive_attempts": 3,
    "prg_attempts": 3,
    "folder_attempts": 3,
    "enlarge_window": true,
    "scroll_attempts": 4,
    "max_icon_attempts": 8,
    "ttp_cancel_attempts": 2
  },
  "tmp_dir": "/tmp/marcer-shotgen",
  "resource_limits": {
    "per_job_mb": 800,
    "min_free_mb": 2000,
    "min_disk_free_mb": 2048,
    "stale_stage_hours": 1,
    "mem_guard_fraction": 1.5
  },
  "xvfb_screen": "1024x768x24",
  "profile": {
    "name": "st",
    "machine": "st",
    "memsize": "1",
    "zoom": "1",
    "extra_args": []
  }
}
