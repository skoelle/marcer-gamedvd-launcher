# Ignore build artifacts
bin/
obj/
# User-specific or machine-generated files
*.user
*.vs
*.vscode
*.suo
*.userosscache
*.sln.docstates
# OS junk
.DS_Store
Thumbs.db
stdout.log

# Python virtual environment
.venv/

# Release-Verzeichnis (keine ZIPs o.ä. ins Git!)
# Only ignore top-level release/ directory. Release directories in subfolders are allowed.
/release/

# User-specific configuration (real config, not example)
launcher.config.json
favorites.txt
desktop.config.json

# Flutter / Dart (apps/marcer_desktop)
**/.dart_tool/
**/build/
.flutter-plugins
.flutter-plugins-dependencies

# Demo directory (generated by apps/marcer_console/demo.sh)
.demo/

# Tool bytecode
/tools/screenshot-gen/__pycache__/
/tools/gameinfo-gen/__pycache__/
/tools/atarilegend-gen/__pycache__/
/tools/asset-manifest/__pycache__/
/tools/archive-sync/__pycache__/
/tools/archive-sync/tests/__pycache__/
/tools/crew-analysis/__pycache__/
/tools/gallery/__pycache__

# Local tool data (paths.env, PirateFinder catalogue, analysis outputs)
/local/

# PirateFinder tool bytecode
/tools/piratefinder-gen/**/__pycache__/

# Local machine-specific tool overrides (docs mention config.local.json)
/tools/screenshot-gen/config.local.json
